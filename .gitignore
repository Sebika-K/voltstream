# Environment / secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ML artifacts (large/binary, not source)
ml/models/*.joblib
*.joblib

# ML training data (regenerated from the database via build_dataset.py --
# not source, and grows every time the simulator runs; see Roadmap 4.2)
ml/data/*.csv

# Docker
docker-compose.override.yml

# Load-test results (throwaway CSVs from loadtest/README.md's headless runs --
# not source, regenerated by every run; keep a specific run's numbers by renaming
# or copying it elsewhere if you actually want to keep one)
loadtest/results/*.csv

# IDE / OS
.vscode/
.idea/
.DS_Store
*.swp

# Logs
*.log
