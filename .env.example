# Copy this file to .env and adjust values as needed.
# .env is gitignored -- never commit real credentials.

# --- PostgreSQL (used by docker-compose to configure the postgres service) ---
POSTGRES_USER=voltstream
POSTGRES_PASSWORD=change-me
POSTGRES_DB=voltstream
POSTGRES_PORT=5432

# --- Backend ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# "json" (default): one JSON object per log line -- what Docker/log tools want.
# "text": a readable single line, nicer when running `uvicorn --reload` in a terminal.
LOG_FORMAT=json
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser origins allowed to call the API (comma-separated). The defaults already
# include the Vite dev server (5173) and the containerized frontend (3000), so you
# only need to set this if the frontend is served from somewhere else.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Full SQLAlchemy async database URL used by the backend application and by Alembic.
#
# - Running everything through `docker-compose up`: you do NOT need to set this --
#   docker-compose.yml builds it from the POSTGRES_* values above using the "postgres"
#   Docker DNS service name.
# - Running the backend directly on the host (e.g. `uvicorn app.main:app --reload`)
#   against dockerized Postgres, or against a local Postgres install: set this to point
#   at "localhost" instead, matching the POSTGRES_* credentials above, e.g.:
DATABASE_URL=postgresql+asyncpg://voltstream:change-me@localhost:5432/voltstream

# --- Simulator (Roadmap 1.10; Contract section 54's defaults shown here) ---
# Not needed to run the backend or its tests -- only read by `simulator/main.py`.
DEVICE_COUNT=100
TELEMETRY_INTERVAL_SECONDS=1
FAULT_RATE=0.0
RANDOM_SEED=42
BATCH_SIZE=100

# Where the simulator sends telemetry. Running the backend directly on the host
# (e.g. `uvicorn app.main:app --reload`), as this step assumes: leave this as
# localhost. Under Docker Compose this is overridden automatically to the Docker DNS
# name http://backend:8000 (never localhost between containers), so no change is needed.
BACKEND_URL=http://localhost:8000
